#!/usr/bin/env bash
# zctx — текущее заполнение контекстного окна сессии ZCode.
# Читает usage из транскрипта модели (~/.zcode/cli/rollout/model-io-*.jsonl;
# каталог переопределяется переменной $ZCTX_ROLLDIR).
#
# Использование:
#   zctx                 # самая свежая по mtime сессия
#   zctx -s <id|часть>   # выбрать сессию по sessionId/имени файла
#   zctx --main          # сессия оркестратора: свежий model-io-*.jsonl без «subagent» в имени (при -s приоритет у -s)
#   zctx --delta [N]     # рост окна за последние N запросов с usage (по умолч. 20), одна строка:
#                        #   старт = inputTokens первого запроса окна, сейчас = inputTokens+outputTokens последнего;
#                        #   «свои ответы» = сумма outputTokens этих запросов, остальной рост = выводы инструментов и прочее;
#                        #   ownPct — доля своих ответов в росте (не выше 100; 0, если окно не выросло — в окне была компакция);
#                        #   requests — сколько запросов реально в окне (меньше N: сессия только начата или её транскрипт обрезан)
#   zctx --limit N       # лимит окна (по умолч. $ZCTX_LIMIT или 1000000)
#   zctx --warn-at N     # абсолютный порог warn в токенах (вместо 80% от лимита)
#   zctx --json          # машинный вывод для jq; с --delta — одна строка + поля deltaStart, delta, own, other, ownPct, requests
set -euo pipefail

ROLLDIR="${ZCTX_ROLLDIR:-$HOME/.zcode/cli/rollout}"
LIMIT="${ZCTX_LIMIT:-1000000}"
WARN_AT="${ZCTX_WARN_AT:-}"
SESSION=""
MAIN=0
DELTA=0
N=20
JSON=0
while [[ $# -gt 0 ]]; do
  case "$1" in
    -s|--session) SESSION="$2"; shift 2 ;;
    --main) MAIN=1; shift ;;
    --delta)
      # N необязателен: забираем следующий аргумент, только если это число.
      if [[ $# -ge 2 && "${2:-}" =~ ^[0-9]+$ ]]; then N="$2"; shift 2; else shift; fi
      DELTA=1 ;;
    --delta=*) N="${1#*=}"; DELTA=1; shift ;;
    --limit) LIMIT="$2"; shift 2 ;;
    --warn-at) WARN_AT="$2"; shift 2 ;;
    --json) JSON=1; shift ;;
    -h|--help) sed -n '2,/^set -euo pipefail/p' "$0" | sed '$d'; exit 0 ;;
    *) echo "unknown arg: $1" >&2; exit 2 ;;
  esac
done
if [[ ! "$N" =~ ^[0-9]+$ ]] || (( 10#$N < 1 )); then
  echo "--delta: expected a positive number of requests, got: '$N'" >&2; exit 2
fi
N=$(( 10#$N ))

# Транскрипты от самого свежего к старым. `|| true` и потребители, читающие ввод до конца
# (а не обрывающие его после первой строки), обязательны: иначе при пустом результате
# или без совпадений pipeline вернул бы не ноль, и `set -e` оборвал бы скрипт РАНЬШЕ
# сообщения об ошибке.
newest_first() { ls -t -- "$ROLLDIR"/model-io-*.jsonl 2>/dev/null || true; }
first_line() { awk 'NR == 1'; }

if [[ -n "$SESSION" ]]; then
  FILE=$(newest_first | { grep -i -- "$SESSION" || true; } | first_line)
  [[ -n "$FILE" ]] || { echo "session not found: $SESSION" >&2; exit 1; }
elif (( MAIN )); then
  # Сессия оркестратора = самый свежий файл без «subagent» в ИМЕНИ
  # (в пути каталога это слово допустимо).
  FILE=$(newest_first | awk -F/ '{ f = tolower($NF) } f !~ /subagent/ && !found { print; found = 1 }')
  [[ -n "$FILE" ]] || { echo "main session not found: no model-io-*.jsonl without \"subagent\" in name in $ROLLDIR" >&2; exit 1; }
else
  FILE=$(newest_first | first_line)
fi
[[ -n "$FILE" && -f "$FILE" ]] || { echo "no rollout files in $ROLLDIR" >&2; exit 1; }

# Одна проходка по файлу (поточно, без slurp). Окно = последние n записей с корректным
# usage; записи без usage и оборванные строки (файл живой сессии дописывается прямо во
# время чтения) не считаются. При n = 1 это просто последняя запись с usage.
usage_metrics() { # <n> → JSON {inputTokens, outputTokens, used, deltaStart, delta, own, other, ownPct, requests}; пусто, если usage нет
  jq -n -R --argjson n "$1" '
    reduce (inputs | fromjson? | objects | .response.usage?
            | select((type == "object") and ((.inputTokens | type) == "number") and ((.outputTokens | type) == "number")))
      as $u ({ q: [] }; .q |= (. + [$u] | if length > $n then .[length - $n:] else . end))
    | .q
    | select(length > 0)
    | .[0].inputTokens as $start
    | (.[-1].inputTokens + .[-1].outputTokens) as $now
    | ([.[].outputTokens] | add) as $own
    | ($now - $start) as $d
    | { inputTokens: .[-1].inputTokens, outputTokens: .[-1].outputTokens, used: $now,
        deltaStart: $start, delta: $d, own: $own, other: ($d - $own),
        ownPct: (if $d > 0 then ([$own * 100 / $d, 100] | min | floor) else 0 end),
        requests: length }' < "$FILE"
}
if (( DELTA )); then METRICS=$(usage_metrics "$N"); else METRICS=$(usage_metrics 1); fi \
  || { echo "cannot read $FILE" >&2; exit 1; }
[[ -n "$METRICS" ]] || { echo "no usage records in $FILE" >&2; exit 1; }
read -r IN OUT USED D_START D_VAL D_OWN D_OTHER D_PCT D_REQ <<< "$(jq -r \
  '[.inputTokens, .outputTokens, .used, .deltaStart, .delta, .own, .other, .ownPct, .requests] | @tsv' <<< "$METRICS")"

# inputTokens уже включает cacheRead; +outputTokens — оценка контекста,
# на котором соберётся следующий ход.
PCT=$(( USED * 100 / LIMIT ))
STATUS=ok
if (( USED * 10 >= LIMIT * 9 )); then
  STATUS=stop
elif [[ -n "$WARN_AT" ]] && (( USED >= WARN_AT )); then
  STATUS=warn
elif (( PCT >= 80 )); then
  STATUS=warn
fi

if (( DELTA )); then
  if (( JSON )); then
    jq -c -n --arg file "$(basename "$FILE")" --argjson used "$USED" --argjson limit "$LIMIT" \
          --argjson in "$IN" --argjson out "$OUT" --arg status "$STATUS" \
          --argjson warnAt "${WARN_AT:-null}" \
          --argjson deltaStart "$D_START" --argjson delta "$D_VAL" --argjson own "$D_OWN" \
          --argjson other "$D_OTHER" --argjson ownPct "$D_PCT" --argjson requests "$D_REQ" \
      '{file:$file, used:$used, limit:$limit, percent:($used*100/$limit|floor), warnAt:$warnAt, inputTokens:$in, outputTokens:$out, status:$status,
        deltaStart:$deltaStart, delta:$delta, own:$own, other:$other, ownPct:$ownPct, requests:$requests}'
  else
    printf 'session %s  delta %+d, requests %d (%d → %d): свои ответы %d (%d%%), инструменты и прочее %d\n' \
      "$(basename "$FILE")" "$D_VAL" "$D_REQ" "$D_START" "$USED" "$D_OWN" "$D_PCT" "$D_OTHER"
  fi
elif (( JSON )); then
  jq -n --arg file "$(basename "$FILE")" --argjson used "$USED" --argjson limit "$LIMIT" \
        --argjson in "$IN" --argjson out "$OUT" --arg status "$STATUS" \
        --argjson warnAt "${WARN_AT:-null}" \
    '{file:$file, used:$used, limit:$limit, percent:($used*100/$limit|floor), warnAt:$warnAt, inputTokens:$in, outputTokens:$out, status:$status}'
else
  printf 'session %s\ncontext %s / %s (%d%%) [%s]\n' "$(basename "$FILE")" "$USED" "$LIMIT" "$PCT" "$STATUS"
fi
